# Copy this file to .env and fill in your own values. .env is ignored by git.

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=podfessor
DB_USER=podfessor
DB_PASS=change-me

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional: defaults to gpt-5
OPENAI_MODEL=
# Optional text-to-speech settings (defaults: gpt-4o-mini-tts, coral)
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# Optional: episodes each account can create per day (default 30)
DAILY_EPISODE_LIMIT=
# Optional: where MP3 files are saved (default storage/audio)
AUDIO_DIR=
